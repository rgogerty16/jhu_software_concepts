# Repository-level ignores (moved up from the per-module folders in Module 6).

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Testing / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Secrets / local config
.env
*.env
!*.env.example
# Root-level credential exports, e.g. the IAM console CSV that AWS hands you on
# user creation. Scoped to the root and to the word "credentials" on purpose:
# a blanket *.csv rule would swallow module_8's tracked summary_statistics.csv
# and missingness_summary.csv, which are deliverables.
/*credentials*

# Per-module submission archives. These are rebuilt from the module folders on
# demand, so keeping them in the repository just duplicates every module.
*.zip

# Local experiment-tracking state from Module 11. The MLflow run evidence that
# matters is committed as screenshots; the database and artifact store are
# regenerated by re-running the pipeline.
mlflow.db
mlartifacts/
mlruns/
wandb/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
