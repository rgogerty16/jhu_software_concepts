# Copy to .env for local runs:  cp .env.example .env
# .env is git-ignored — NEVER commit real values, and NEVER put AWS access keys
# here. On SageMaker, boto3 resolves credentials automatically from the notebook
# instance's IAM execution role (the default provider chain), so no keys are
# needed at all.

# AWS region of your S3 bucket (e.g. us-east-1). Leave blank to inherit the
# notebook/instance default region.
AWS_REGION=

# S3 source object (raw dataset) and the local file the download writes.
S3_BUCKET=grad-cafe-rg
S3_KEY=applicant_data.json
OUTPUT_FILE=applicant_data_SM.json

# S3 key the cleaned dataset is uploaded back to (assignment step 9).
S3_CLEAN_KEY=cleaned_gradcafe.json

# LOCAL AUTHORING ONLY: if set to a JSON path, the notebook reads/writes locally
# instead of calling S3 (used to develop the notebook off-cloud). LEAVE UNSET on
# SageMaker so the real boto3 S3 download/upload runs.
# LOCAL_DATASET=/path/to/applicant_data.json
