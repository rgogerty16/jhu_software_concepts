# ── Secrets / credentials — NEVER commit ─────────────────────────────────────
# NOTE: .gitignore does not support trailing inline comments — the comment text
# becomes part of the pattern and silently breaks it. Keep comments on own lines.
.env
# EC2 SSH private keys
*.pem
# IAM "Create access key" downloads
credentials*.csv
accessKeys*.csv
*_accessKeys.csv

# ── Large / generated data ───────────────────────────────────────────────────
# The notebook downloads these on SageMaker; the worker gets its copy via scp.
# They are 15–18 MB and are regenerated, so they stay out of git.
applicant_data.json
applicant_data_SM.json
ec2/data/

# ── Python / tooling noise ───────────────────────────────────────────────────
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
